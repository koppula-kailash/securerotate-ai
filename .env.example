# =================================================================
# SecureRotate AI - Local Development Environment Template
# Beginners: Copy this file to '.env' in the project root directory!
# =================================================================

# --- Application Configuration ---
APP_ENV=development
DEBUG=True
PROJECT_NAME="SecureRotate AI"
API_V1_STR="/api/v1"

# --- FastAPI Local Server ---
HOST=127.0.0.1
PORT=8000

# --- Authentication & Secrets ---
# Secret key for signing JWT tokens (use any random string in local dev)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# LocalSecretProvider Key (Fernet authenticated encryption key for local password vault)
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=CHANGE_ME

# --- Secret Provider Type ---
# Options: LOCAL (uses LocalSecretProvider with Fernet authenticated encryption), VAULT (future HashiCorp Vault), AWS_SECRETS_MANAGER
SECRET_PROVIDER_TYPE=LOCAL

# --- Local MySQL Server Settings (Single Server, Dual DBs) ---
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME

# 1. Primary System Metadata Database
SYSTEM_DB_NAME=securerotate_db
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@localhost:3306/securerotate_db

# 2. Target Demo Database (Target DB for practicing credential rotations)
TARGET_DEMO_DB_NAME=target_demo_db
TARGET_DEMO_DB_USER=demo_user
TARGET_DEMO_DB_PASSWORD=CHANGE_ME
TARGET_DEMO_DATABASE_URL=mysql+aiomysql://demo_user:CHANGE_ME@localhost:3306/target_demo_db

# --- Notification System (Console / Email Mock) ---
NOTIFY_FROM_EMAIL=alerts@securerotate.ai
ALERT_LEAD_DAYS=7
ENABLE_CONSOLE_NOTIFICATIONS=True

# --- Machine Learning Model Config ---
ML_MODEL_PATH=backend/app/ml/models/risk_model.pkl
RISK_THRESHOLD_HIGH=0.75
RISK_THRESHOLD_MEDIUM=0.40

# --- APScheduler Settings ---
EXPIRY_CHECK_CRON="0 0 * * *"
